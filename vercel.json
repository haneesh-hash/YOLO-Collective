{
    "version": 2,
    "buildCommand": "",
    "installCommand": "cd api && npm install",
    "outputDirectory": ".",
    "functions": {
        "api/contact.js": {
            "memory": 128,
            "maxDuration": 10,
            "includeFiles": "api/**"
        }
    },
    "redirects": [
        {
            "source": "/:path(.*)",
            "has": [{ "type": "host", "value": "www.theyolocollective.com" }],
            "destination": "https://theyolocollective.com/:path",
            "permanent": true
        }
    ],
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/(.*)", "destination": "/$1" }
    ]
}

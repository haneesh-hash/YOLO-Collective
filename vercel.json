{
    "version": 2,
    "buildCommand": null,
    "outputDirectory": ".",
    "functions": {
        "api/contact.js": {
            "memory": 128,
            "maxDuration": 10
        }
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}

{
    "version": 2,
    "buildCommand": "",
    "installCommand": "cd api && npm install",
    "outputDirectory": ".",
    "functions": {
        "api/contact.js": {
            "memory": 128,
            "maxDuration": 10,
            "includeFiles": "api/**"
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/(.*)", "destination": "/$1" }
    ]
}
